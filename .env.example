# Copy to .env and fill in. .env is gitignored.

# Every provider whose settings are filled in below is turned on, and the TUI
# lists VMs from all of them. PROVIDER is the default for launching; override
# it per command with --provider. Run `pnpm cli providers` to check.
PROVIDER=digitalocean

# Public key installed for the `agent` user on new VMs
SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub

# --- Agent tool API keys (optional) ---
# Used when you launch with "API keys from .env" (for swarms). Copied to new
# VMs over SSH, never into the cloud provider's VM setup data. With "Sign in
# yourself" you use your own Claude/ChatGPT plan on each VM instead.
# See docs/agent-credentials.md. Re-apply with `pnpm cli keys <vm>`.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Tailscale (optional) ---
# Puts VMs launched with the Tailscale option on your private tailnet, so you
# can reach them from your phone. Create a reusable auth key at
# https://login.tailscale.com/admin/settings/keys (not ephemeral, so asleep
# VMs keep their place). Only used to join; it isn't kept on the VM. Without
# it, sign in on each VM with `l`. See docs/phone-access.md.
TAILSCALE_AUTH_KEY=

# --- DigitalOcean ---
# Personal access token with read + write scope:
# https://cloud.digitalocean.com/account/api/tokens
DIGITALOCEAN_TOKEN=
# Run `pnpm cli regions`, `pnpm cli sizes`, `pnpm cli images` to see options.
DO_REGION=nyc1
DO_SIZE=s-2vcpu-4gb
DO_IMAGE=ubuntu-24-04-x64

# --- AWS (EC2) ---
# Off unless enabled here, since many machines already have AWS credentials
# for other work. Credentials come from the standard AWS chain: AWS_PROFILE
# (incl. SSO), or AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY.
# Needs a default VPC in the region; a security group "agent-vm-ssh"
# (inbound SSH only) is created on first launch.
AWS_ENABLED=false
# AWS_PROFILE=
AWS_REGION=us-east-1
AWS_INSTANCE_TYPE=t3.medium
# ubuntu-24.04 = Canonical's latest Ubuntu 24.04 image, or an AMI id
AWS_IMAGE=ubuntu-24.04

# --- OVHcloud ---
# Create credentials at https://eu.api.ovh.com/createToken/
# (or ca.api.ovh.com / api.us.ovhcloud.com for other account regions) with
# GET/POST/PUT/DELETE rights on /cloud/project/<project-id>/*
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
# Public Cloud project ID (the "service name" in the OVH API)
OVH_PROJECT_ID=
OVH_REGION=GRA11
OVH_FLAVOR=b3-8
OVH_IMAGE=Ubuntu 24.04
