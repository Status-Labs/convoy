# Copy to .env and fill in. .env is gitignored.

# OVH API credentials. Create them at https://eu.api.ovh.com/createToken/
# (or ca.api.ovh.com / api.us.ovhcloud.com for other account regions) with
# GET/POST/PUT/DELETE rights on /cloud/project/<project-id>/*
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# Public Cloud project ID (the "service name" in the OVH API)
OVH_PROJECT_ID=

# VM defaults. Run `pnpm cli regions`, `pnpm cli flavors`, `pnpm cli images` to see options.
OVH_REGION=GRA11
OVH_FLAVOR=b3-8
OVH_IMAGE=Ubuntu 24.04

# Public key injected into new VMs
SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub
